{
    "$schema": "https://turborepo.com/schema.json",
    "globalDependencies": ["**/.env.*local"],
    "tasks": {
        "dev": {
            "cache": false,
            "persistent": true
        },
        "build": {
            "dependsOn": ["^build"],
            "outputs": [".next/**", "!.next/cache/**", "dist/**"],
            "env": [
                "API_PORT",
                "DB_HOST",
                "DB_PORT",
                "DB_USERNAME",
                "DB_PASSWORD",
                "DB_NAME",
                "JWT_SECRET",
                "SALT",
                "NEXT_PUBLIC_COMMENTS_API_KEY"
            ]
        },
        "lint": {},
        "test": {},
        "test:e2e": {}
    }
}
